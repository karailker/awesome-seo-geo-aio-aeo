{
  "name": "awesome-seo",
  "description": "Local SEO / GEO / AIO / AEO auditor for a single site: sitemap-driven crawl, search console and analytics APIs, performance measurements, evidence-backed reports.",
  "version": "0.2.0",
  "license": "MIT",
  "author": {
    "name": "Ilker Kara"
  },
  "mcpServers": {
    "google": {
      "command": "npx",
      "args": ["-y", "@karailker/awesome-seo-mcp-google"]
    },
    "yandex": {
      "command": "npx",
      "args": ["-y", "@karailker/awesome-seo-mcp-yandex"]
    },
    "bing": {
      "command": "npx",
      "args": ["-y", "@karailker/awesome-seo-mcp-bing"]
    },
    "performance": {
      "command": "npx",
      "args": ["-y", "@karailker/awesome-seo-mcp-performance"]
    },
    "crawl": {
      "command": "uv",
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}/mcp-servers/crawl", "crawl-server"],
      "env": {"AWESOME_SEO_DATA_DIR": "${CLAUDE_PROJECT_DIR}/data"}
    }
  }
}
