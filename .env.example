# Credential variable NAMES only - never commit real values.
# Preferred storage is the OS keychain; a plain .env is for local development only and is git-ignored.
# Key files (service accounts) must live outside this repository; point the variable at the path.

GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_MERCHANT_OAUTH_TOKEN_FILE=
YANDEX_WEBMASTER_TOKEN=
YANDEX_METRICA_TOKEN=
BING_WEBMASTER_API_KEY=
PAGESPEED_API_KEY=
CRUX_API_KEY=
