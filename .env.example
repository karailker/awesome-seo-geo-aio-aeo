# Variable NAMES only - never commit real values.
# Preferred storage: a file outside the repo, mode 600, loaded into the environment before starting Claude Code
# (for example ~/.config/awesome-seo/<source>.env). A plain .env is for local development only and is git-ignored.
# Service account key files must live outside this repository; point the variable at the path.

# Search Console and GA4 (service account key file path)
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Merchant Center (deferred, P9)
GOOGLE_MERCHANT_ACCOUNT_ID=
GOOGLE_MERCHANT_OAUTH_TOKEN_FILE=

# Yandex Metrica and Webmaster (OAuth token from a registered Yandex app)
YANDEX_METRICA_TOKEN=
YANDEX_METRICA_COUNTER_ID=
YANDEX_WEBMASTER_TOKEN=

# Bing Webmaster
BING_WEBMASTER_API_KEY=

# PageSpeed Insights and CrUX
PAGESPEED_API_KEY=
CRUX_API_KEY=
# Optional: path to a Chrome or Chromium binary for the local Lighthouse fallback
CHROME_PATH=

# Crawler and local storage
AWESOME_SEO_CONTACT_URL=
AWESOME_SEO_DB=
AWESOME_SEO_DATA_DIR=
